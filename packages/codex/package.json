{
  "name": "@caelis/codex",
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./src/index.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --sourcemap --clean",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/database/run-migrations.ts",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@caelis/shared": "workspace:*",
    "better-sqlite3": "^13.0.1",
    "drizzle-orm": "^0.45.1",
    "pino": "^10.3.1",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "drizzle-kit": "^0.31.8"
  }
}
